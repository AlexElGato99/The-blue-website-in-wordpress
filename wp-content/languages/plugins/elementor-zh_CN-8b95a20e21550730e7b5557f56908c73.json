f\u4f5c"],"Motion Effects & Animations":["\u8fd0\u52a8\u6548\u679c\u548c\u52a8\u753b"],"Custom Code & CSS":["\u81ea\u5b9a\u4e49\u4ee3\u7801\u548c CSS"],"Popup Builder":["\u5f39\u7a97\u6784\u5efa\u5668"],"Lead Collection & Form Builder":["\u6f5c\u5728\u5ba2\u6237\u6536\u96c6\u548c\u8868\u5355\u751f\u6210\u5668"],"WooCommerce Builder":["WooCommerce \u751f\u6210\u5668"],"Welcome aboard! What's next?":["\u6b22\u8fce\u767b\u673a\uff01\u4e0b\u4e00\u6b65\u662f\u4ec0\u4e48\uff1f"],"Templates & Theme Builder":["\u6a21\u677f\u548c\u4e3b\u9898\u751f\u6210\u5668"],"Essential":["\u57fa\u7840\u7248"],"You're here!":["\u4f60\u5728\u8fd9\u91cc\uff01"],"Choose additional features":["\u9009\u62e9\u9644\u52a0\u529f\u80fd"],"first steps:":["\u7b2c\u4e00\u6b65\uff1a"],"To get the most out of Elementor, we'll help you take your":["\u4e3a\u4e86\u5145\u5206\u5229\u7528 Elementor\uff0c\u6211\u4eec\u5c06\u5e2e\u52a9\u60a8"],"Choose Features":["\u9009\u62e9\u529f\u80fd"],"Based on the features you chose, we recommend the %s plan, or higher":["\u6839\u636e\u60a8\u9009\u62e9\u7684\u529f\u80fd\uff0c\u6211\u4eec\u63a8\u8350 %s \u8ba1\u5212\u6216\u66f4\u9ad8\u7248\u672c"],"Icons":["\u56fe\u6807"],"Choose a professionally-designed template or import your own":["\u9009\u62e9\u4e13\u4e1a\u8bbe\u8ba1\u7684\u6a21\u677f\u6216\u5bfc\u5165\u60a8\u81ea\u5df1\u7684\u6a21\u677f"],"This download requires the 'DOMDocument' PHP extension, which we couldn\u2019t detect on your server. Enable this extension, or get in touch with your hosting service for support, and then give the download another go.":["\u6b64\u4e0b\u8f7d\u9700\u8981\u201cDOMDocument\u201dPHP \u6269\u5c55\uff0c\u6211\u4eec\u65e0\u6cd5\u5728\u60a8\u7684\u670d\u52a1\u5668\u4e0a\u68c0\u6d4b\u5230\u8be5\u6269\u5c55\u3002\u542f\u7528\u6b64\u6269\u5c55\uff0c\u6216\u8054\u7cfb\u60a8\u7684\u6258\u7ba1\u670d\u52a1\u4ee5\u83b7\u5f97\u652f\u6301\uff0c\u7136\u540e\u518d\u6b21\u8fdb\u884c\u4e0b\u8f7d\u3002"],"This is due to a conflict with one or more third-party plugins already active on your site. Try disabling them, and then give the download another go.":["\u8fd9\u662f\u7531\u4e8e\u4e0e\u60a8\u7f51\u7ad9\u4e0a\u5df2\u542f\u7528\u7684\u4e00\u4e2a\u6216\u591a\u4e2a\u7b2c\u4e09\u65b9\u63d2\u4ef6\u53d1\u751f\u51b2\u7a81\u6240\u81f4\u3002\u5c1d\u8bd5\u7981\u7528\u5b83\u4eec\uff0c\u7136\u540e\u518d\u6b21\u5c1d\u8bd5\u4e0b\u8f7d\u3002"],"Upgrade now":["\u73b0\u5728\u5347\u7ea7"],"Uploading JSON or ZIP files from unknown sources can be harmful and put your site at risk. For maximum safety, upload only JSON or ZIP files from trusted sources.":["\u4ece\u672a\u77e5\u6765\u6e90\u4e0a\u4f20 JSON \u6216 ZIP \u6587\u4ef6\u53ef\u80fd\u6709\u5bb3\uff0c\u5e76\u4f7f\u60a8\u7684\u7f51\u7ad9\u9762\u4e34\u98ce\u9669\u3002\u4e3a\u4e86\u83b7\u5f97\u6700\u5927\u7684\u5b89\u5168\u6027\uff0c\u8bf7\u4ec5\u4e0a\u4f20\u6765\u81ea\u53ef\u4fe1\u6765\u6e90\u7684 JSON \u6216 ZIP \u6587\u4ef6\u3002"],"Warning: JSON or ZIP files may be unsafe":["\u8b66\u544a\uff1aJSON \u6216 ZIP \u6587\u4ef6\u53ef\u80fd\u4e0d\u5b89\u5168"],"One":["\u5355\u9009"],"of":["of"],"Couldn\u2019t access the file":["\u65e0\u6cd5\u8bbf\u95ee\u8be5\u6587\u4ef6"],", try again and if the problem persists contact ":["\uff0c\u91cd\u8bd5\uff0c\u5982\u679c\u95ee\u9898\u4ecd\u7136\u5b58\u5728\uff0c\u8bf7\u8054\u7cfb "],"The Website Template includes plugins you don\u2019t have permission to install. Contact your site admin to change your permissions.":["\u7f51\u7ad9\u6a21\u677f\u5305\u542b\u60a8\u65e0\u6743\u5b89\u88c5\u7684\u63d2\u4ef6\u3002\u8054\u7cfb\u60a8\u7684\u7f51\u7ad9\u7ba1\u7406\u5458\u4ee5\u66f4\u6539\u60a8\u7684\u6743\u9650\u3002"],"Seems like Elementor isn\u2019t authorized to access relevant files for installing this Website Template. Contact your site host to get permission.":["\u4f3c\u4e4e Elementor \u65e0\u6743\u8bbf\u95ee\u6709\u5173\u5b89\u88c5\u6b64\u7f51\u7ad9\u6a21\u677f\u7684\u76f8\u5173\u6587\u4ef6\u3002\u8054\u7cfb\u60a8\u7684\u7f51\u7ad9\u4e3b\u673a\u4ee5\u83b7\u53d6\u8bb8\u53ef\u3002"],"We couldn\u2019t download the Website Template due to technical difficulty on our part. Try again in a few minutes and if the problem persists contact ":["\u7531\u4e8e\u6211\u4eec\u7684\u6280\u672f\u56f0\u96be\uff0c\u6211\u4eec\u65e0\u6cd5\u4e0b\u8f7d\u7f51\u7ad9\u6a21\u677f\u3002\u5728\u51e0\u5206\u949f\u5185\u91cd\u8bd5\uff0c\u5982\u679c\u95ee\u9898\u6301\u7eed\u5b58\u5728\uff0c\u8bf7\u8054\u7cfb "],"Seems like there is a problem with the zip\u2019s files. Try installing again and if the problem persists contact ":["ZIP\u6587\u4ef6\u4f3c\u4e4e\u5b58\u5728\u95ee\u9898\u3002\u5c1d\u8bd5\u518d\u6b21\u5b89\u88c5\uff0c\u5982\u679c\u95ee\u9898\u4ecd\u7136\u5b58\u5728\uff0c\u8bf7\u8054\u7cfb "],"Seems like your server is missing the PHP zip module. Install it on your server or contact your site host for further instructions.":["\u60a8\u7684\u670d\u52a1\u5668\u4f3c\u4e4e\u7f3a\u5c11 PHP zip \u6a21\u5757\u3002\u5c06\u5176\u5b89\u88c5\u5728\u60a8\u7684\u670d\u52a1\u5668\u4e0a\u6216\u8054\u7cfb\u60a8\u7684\u7ad9\u70b9\u4e3b\u673a\u4ee5\u83b7\u53d6\u8fdb\u4e00\u6b65\u7684\u8bf4\u660e\u3002"],"Support":["\u652f\u6301"],"We couldn\u2019t download the Website Template due to technical difficulties on our part. Try again and if the problem persists contact ":["\u7531\u4e8e\u6211\u4eec\u7684\u6280\u672f\u56f0\u96be\uff0c\u6211\u4eec\u65e0\u6cd5\u4e0b\u8f7d\u8be5\u7f51\u7ad9\u6a21\u677f\u3002\u518d\u8bd5\u4e00\u6b21\uff0c\u5982\u679c\u95ee\u9898\u4ecd\u7136\u5b58\u5728\uff0c\u8bf7\u8054\u7cfb "],"Go to pages":["\u8f6c\u5230\u9875\u9762"],"Go to the pages screen to make sure your kit pages have been imported successfully. If not, try again.":["\u8f6c\u5230\u9875\u9762\u5c4f\u5e55\u4ee5\u786e\u4fdd\u60a8\u7684\u5957\u4ef6\u9875\u9762\u5df2\u6210\u529f\u5bfc\u5165\u3002\u5982\u679c\u6ca1\u6709\uff0c\u8bf7\u518d\u8bd5\u4e00\u6b21\u3002"],"Applying two Website Templates on the same website will mix global styles and colors and hurt your site's performance.":["\u5728\u540c\u4e00\u7f51\u7ad9\u4e0a\u5e94\u7528\u4e24\u4e2a\u7f51\u7ad9\u6a21\u677f\u4f1a\u6df7\u5408\u5168\u5c40\u6837\u5f0f\u548c\u989c\u8272\uff0c\u5e76\u635f\u5bb3\u7f51\u7ad9\u7684\u6027\u80fd\u3002"],"Apply anyway":["\u4ecd\u7136\u5e94\u7528"],"Do not show this message again":["\u4e0d\u8981\u518d\u663e\u793a\u6b64\u6d88\u606f"],"Ready to Get Elementor Pro?":["\u51c6\u5907\u597d\u83b7\u53d6 Elementor Pro \u4e86\u5417\uff1f"],"What\u2019s a Website Kit?":["\u4ec0\u4e48\u662f\u7f51\u7ad9\u5957\u4ef6\uff1f"],"Export a Website Kit":["\u5bfc\u51fa\u7f51\u7ad9\u5957\u4ef6"],"Upgrade Now":["\u7acb\u5373\u5347\u7ea7"],"Upgrade":["\u5347\u7ea7"],"Uploading":["\u6b63\u5728\u4e0a\u4f20"],"You can switch your theme later on":["\u4f60\u53ef\u4ee5\u7a0d\u540e\u5207\u6362\u4e3b\u9898"],"Already being used by 1M+ web creators":["\u5df2\u7ecf\u88ab\u8d85\u8fc7100\u4e07\u7684\u7f51\u7edc\u521b\u4f5c\u8005\u4f7f\u7528"],"Great for SEO":["\u975e\u5e38\u9002\u5408\u641c\u7d22\u5f15\u64ce\u4f18\u5316"],"Here's why:":["\u539f\u56e0\u5982\u4e0b\uff1a"],"Every site starts with a theme.":["\u6bcf\u4e2a\u7f51\u7ad9\u90fd\u6709\u4e00\u4e2a\u4e3b\u9898\u3002"],"Hello is Elementor's official blank canvas theme optimized to build your website exactly the way you want.":["Hello \u662f Elementor \u7684\u5b98\u65b9\u7a7a\u767d\u753b\u5e03\u4e3b\u9898\uff0c\u7ecf\u8fc7\u4f18\u5316\uff0c\u53ef\u4ee5\u5b8c\u5168\u6309\u7167\u60a8\u60f3\u8981\u7684\u65b9\u5f0f\u6784\u5efa\u60a8\u7684\u7f51\u7ad9\u3002"],"Don't know where to get the file from?":["\u4e0d\u77e5\u9053\u4ece\u54ea\u91cc\u83b7\u53d6\u6587\u4ef6\uff1f"],"Browse":["\u6d4f\u89c8"],"This is what your site is called on the WP dashboard, and can be changed later from the general settings - it's not your website's URL.":["\u8fd9\u662f\u4f60\u7684\u7f51\u7ad9\u5728WP\u4eea\u8868\u677f\u4e0a\u7684\u540d\u79f0\uff0c\u4ee5\u540e\u53ef\u4ee5\u4ece\u5e38\u89c4\u8bbe\u7f6e\u4e2d\u66f4\u6539\u2014\u2014\u5b83\u4e0d\u662f\u4f60\u7f51\u7ad9\u7684URL\u3002"],"Sorry, the name wasn't saved. Try again, or skip for now.":["\u62b1\u6b49\uff0c\u540d\u79f0\u672a\u4fdd\u5b58\u3002\u518d\u8bd5\u4e00\u6b21\uff0c\u6216\u8005\u6682\u65f6\u8df3\u8fc7\u3002"],"This file type is not supported. Try a different type of file":["\u4e0d\u652f\u6301\u6b64\u6587\u4ef6\u7c7b\u578b\u3002\u5c1d\u8bd5\u5176\u4ed6\u7c7b\u578b\u7684\u6587\u4ef6"],"Open Media Library":["\u5f00\u653e\u5a92\u4f53\u5e93"],"Drop image here":["\u5c06\u56fe\u50cf\u62d6\u5230\u8fd9\u91cc"],"Potential Site Logo":["\u6f5c\u5728\u7f51\u7ad9\u6807\u8bc6"],"Otherwise, you can skip this and add one later.":["\u5426\u5219\uff0c\u60a8\u53ef\u4ee5\u8df3\u8fc7\u8fd9\u4e00\u6b65\uff0c\u7a0d\u540e\u518d\u6dfb\u52a0\u4e00\u4e2a\u3002"],"Have a logo? Add it here.":["\u6709\u6807\u5fd7\u5417? \u6dfb\u52a0\u5230\u8fd9\u91cc\u3002"],"Okay, now we're really close...":["\u597d\u4e86\uff0c\u73b0\u5728\u6211\u4eec\u771f\u7684\u5f88\u63a5\u8fd1\u4e86\u3002\u3002\u3002"],"Now, let's give your site a name.":["\u9996\u5148\uff0c\u8ba9\u6211\u4eec\u7ed9\u60a8\u7684\u7ad9\u70b9\u8d77\u4e2a\u540d\u5b57\u3002"],"Hold on, this can take a minute...":["\u7b49\u4e00\u4e0b\uff0c\u8fd9\u53ef\u80fd\u9700\u8981\u4e00\u5206\u949f..."],"That's a wrap! What's next?":["\u8fd9\u5c31\u7ed3\u675f\u4e86! \u4e0b\u4e00\u6b65\u662f\u4ec0\u4e48\uff1f"],"Connect your account":["\u8fde\u63a5\u4f60\u7684\u8d26\u6237"],"You're here! Let's set things up.":["\u4f60\u6765\u4e86! \u8ba9\u6211\u4eec\u628a\u4e8b\u60c5\u5b89\u6392\u597d\u3002"],"There was a problem with enabling SVG uploads. Try again, or use another image format.":["\u542f\u7528 SVG \u4e0a\u4f20\u65f6\u51fa\u73b0\u95ee\u9898\u3002\u518d\u8bd5\u4e00\u6b21\uff0c\u6216\u4f7f\u7528\u5176\u4ed6\u56fe\u50cf\u683c\u5f0f\u3002"],"This allows Elementor to scan your SVGs for malicious content. If you do not wish to allow this, use a different image format.":["\u8fd9\u5141\u8bb8 Elementor \u626b\u63cf\u60a8\u7684 SVG \u4e2d\u662f\u5426\u5b58\u5728\u6076\u610f\u5185\u5bb9\u3002\u5982\u679c\u60a8\u4e0d\u60f3\u5141\u8bb8\u8fd9\u6837\u505a\uff0c\u8bf7\u4f7f\u7528\u4e0d\u540c\u7684\u56fe\u50cf\u683c\u5f0f\u3002"],"Click here to create a new page and open it in Elementor Editor":["\u5355\u51fb\u6b64\u5904\u521b\u5efa\u65b0\u9875\u9762\u5e76\u5728 Elementor \u7f16\u8f91\u5668\u4e2d\u6253\u5f00\u5b83"],"Edit a blank canvas with the Elementor Editor":["\u4f7f\u7528 Elementor \u7f16\u8f91\u5668\u7f16\u8f91\u7a7a\u767d\u753b\u5e03"],"Upload and Install Elementor Pro":["\u4e0a\u4f20\u5e76\u5b89\u88c5 Elementor Pro"],"Import your Elementor Pro plugin file":["\u5bfc\u5165\u60a8\u7684 Elementor Pro \u63d2\u4ef6\u6587\u4ef6"],"Drag & Drop your .zip file here":["\u5c06\u60a8\u7684 .zip \u6587\u4ef6\u62d6\u653e\u5230\u6b64\u5904"],"Your site's got Hello theme. High-five!":["\u54c7\u5594\uff01\u60a8\u7684\u7f51\u7ad9\u6b63\u5728\u4f7f\u7528 Hello \u4e3b\u9898\u3002"],"Oops, the connection failed. Try again.":["\u54ce\u5440\uff0c\u8fde\u63a5\u5931\u8d25\u3002\u8bf7\u518d\u8bd5\u4e00\u6b21\u3002"],"Take part in the community forum, share & grow together":["\u53c2\u52a0\u793e\u533a\u8bba\u575b\uff0c\u5206\u4eab\u5e76\u5171\u540c\u6210\u957f"],"Manage your site with our handy dashboard":["\u7528\u6211\u4eec\u65b9\u4fbf\u7684\u4eea\u8868\u677f\u7ba1\u7406\u4f60\u7684\u7f51\u7ad9"],"Choose from countless professional templates":["\u4ece\u65e0\u6570\u7684\u4e13\u4e1a\u6a21\u677f\u4e2d\u9009\u62e9"],"Then you can:":["\u90a3\u4e48\u60a8\u53ef\u4ee5\uff1a"],"Create Account":["\u521b\u5efa\u8d26\u53f7"],"Elementor Logo":["Elementor Logo"],"And so much more!":["\u8fd8\u6709\u66f4\u591a\uff01"],"Premium Support":["\u9ad8\u7ea7\u652f\u6301"],"Elementor Templates":["Elementor \u6a21\u677f"],"Included":["\u5305\u542b"],"Site Area":["\u7f51\u7ad9\u533a\u57df"],"Custom Post Types":["\u81ea\u5b9a\u4e49\u6587\u7ae0\u7c7b\u578b"],"WP Menus":["WP\u83dc\u5355"],"90+ Basic & Pro widgets":["90+ \u57fa\u672c\u548c\u4e13\u4e1a\u7ec4\u4ef6"],"300+ Basic & Pro templates":["300+ \u57fa\u672c\u548c\u4e13\u4e1a\u6a21\u677f"],"Create New Elementor Page":["\u521b\u5efa\u65b0\u7684 Elementor \u9875\u9762"],"Blank Canvas":["\u7a7a\u767d\u753b\u5e03"],"To turn your site into a Website Kit, select the templates, content, settings and plugins you want to include. Once it\u2019s ready, you\u2019ll get a .zip file that you can import to other sites.":["\u8981\u5c06\u60a8\u7684\u7f51\u7ad9\u53d8\u6210\u7f51\u7ad9\u5957\u4ef6\uff0c\u8bf7\u9009\u62e9\u60a8\u60f3\u8981\u5305\u542b\u7684\u6a21\u677f\u3001\u5185\u5bb9\u3001\u8bbe\u7f6e\u548c\u63d2\u4ef6\u3002\u51c6\u5907\u5c31\u7eea\u540e\uff0c\u60a8\u5c06\u83b7\u5f97\u4e00\u4e2a .zip \u6587\u4ef6\uff0c\u60a8\u53ef\u4ee5\u5c06\u5176\u5bfc\u5165\u5230\u5176\u4ed6\u7f51\u7ad9\u3002"],"Choose how to start creating":["\u9009\u62e9\u5982\u4f55\u5f00\u59cb\u521b\u5efa"],"Give your site a name & logo":["\u4e3a\u60a8\u7684\u7f51\u7ad9\u63d0\u4f9b\u540d\u79f0\u548c logo"],"Set your site's theme":["\u8bbe\u7f6e\u7f51\u7ad9\u7684\u4e3b\u9898"],"Good to Go":["\u51c6\u5907\u5f00\u59cb"],"Hello Theme":["Hello \u4e3b\u9898"],"Already have Elementor Pro?":["\u5df2\u7ecf\u6709 Elementor Pro \u4e86\uff1f"],"Elementor Account":["Elementor \u8d26\u53f7"],"Let's do it":["\u6211\u4eec\u5f00\u59cb\u884c\u52a8\u5427"],"Start by uploading the file and selecting the parts and plugins you want to apply. If there are any overlaps between the kit and your current design, you\u2019ll be able to choose which imported parts you want to apply or ignore. Once the file is ready, the kit will be applied to your site and you\u2019ll be able to see it live.":["\u9996\u5148\uff0c\u4e0a\u4f20\u6587\u4ef6\u5e76\u9009\u62e9\u60a8\u60f3\u8981\u5e94\u7528\u7684\u90e8\u4ef6\u548c\u63d2\u4ef6\u3002\u5982\u679c\u6a21\u677f\u5de5\u5177\u5305\u4e0e\u60a8\u5f53\u524d\u7684\u8bbe\u8ba1\u5b58\u5728\u4efb\u4f55\u91cd\u53e0\u90e8\u5206\uff0c\u60a8\u5c06\u80fd\u591f\u9009\u62e9\u8981\u5e94\u7528\u6216\u5ffd\u7565\u54ea\u4e9b\u5df2\u5bfc\u5165\u7684\u90e8\u4ef6\u3002\u6587\u4ef6\u51c6\u5907\u5c31\u7eea\u540e\uff0c\u8be5\u5de5\u5177\u5305\u5c06\u88ab\u5e94\u7528\u5230\u60a8\u7684\u7ad9\u70b9\uff0c\u60a8\u4fbf\u53ef\u4ee5\u5b9e\u65f6\u67e5\u770b\u6548\u679c\u3002"],"To get the most out of Elementor, we'll connect your account.":["\u4e3a\u4e86\u5145\u5206\u5229\u7528 Elementor \u7684\u529f\u80fd\uff0c\u6211\u4eec\u5c06\u5173\u8054\u60a8\u7684\u8d26\u6237\u3002"],"A Website Kit is a .zip file that contains all the parts of a complete site. It\u2019s an easy way to get a site up and running quickly.":["\u7f51\u7ad9\u5957\u4ef6\u662f\u4e00\u4e2a .zip \u6587\u4ef6\uff0c\u5176\u4e2d\u5305\u542b\u5b8c\u6574\u7f51\u7ad9\u7684\u6240\u6709\u90e8\u5206\u3002\u8fd9\u662f\u5feb\u901f\u542f\u52a8\u548c\u8fd0\u884c\u7f51\u7ad9\u7684\u7b80\u5355\u65b9\u6cd5\u3002"]," Recommended:":["\u63a8\u8350\uff1a"],"Add the custom posts types to export. The latest 20 items from each type will be included.":["\u6dfb\u52a0\u8981\u5bfc\u51fa\u7684\u81ea\u5b9a\u4e49\u5e16\u5b50\u7c7b\u578b\u3002\u5c06\u5305\u542b\u6bcf\u79cd\u7c7b\u578b\u7684\u6700\u65b0 20 \u4ef6\u5546\u54c1\u3002"],"No custom post types in your site...":["\u60a8\u7684\u7f51\u7ad9\u4e2d\u6ca1\u6709\u81ea\u5b9a\u4e49\u5e16\u5b50\u7c7b\u578b..."],"Click to select custom post types":["\u5355\u51fb\u4ee5\u9009\u62e9\u81ea\u5b9a\u4e49\u5e16\u5b50\u7c7b\u578b"],"Import a Website Kit to your site":["\u5c06\u7f51\u7ad9\u5957\u4ef6\u5bfc\u5165\u60a8\u7684\u7f51\u7ad9"],"Importing your content, templates and site settings":["\u5bfc\u5165\u60a8\u7684\u5185\u5bb9\u3001\u6a21\u677f\u548c\u7f51\u7ad9\u8bbe\u7f6e"],"Head over to Updates and make sure that your plugins are updated to the latest version.":["\u524d\u5f80\u66f4\u65b0\u5e76\u786e\u4fdd\u60a8\u7684\u63d2\u4ef6\u5df2\u66f4\u65b0\u5230\u6700\u65b0\u7248\u672c\u3002"],"Not yet":["\u8fd8\u6ca1\u6709"],"If you\u2019ve purchased, installed & activated Elementor Pro, we can continue importing all the parts of this site.":["\u5982\u679c\u60a8\u5df2\u8d2d\u4e70\u3001\u5b89\u88c5\u5e76\u6fc0\u6d3b Elementor Pro\uff0c\u6211\u4eec\u53ef\u4ee5\u7ee7\u7eed\u5bfc\u5165\u8be5\u7f51\u7ad9\u7684\u6240\u6709\u90e8\u5206\u3002"],"Parts of this kit overlap with your site\u2019s templates, design and settings. The items you leave checked on this list will replace your current design.":["\u200b\u200b\u8bf7\u6ce8\u610f\uff1a\u6b64\u5de5\u5177\u5305\u4e2d\u7684\u90e8\u5206\u5185\u5bb9\u4e0e\u60a8\u7ad9\u70b9\u7684\u6a21\u677f\u3001\u8bbe\u8ba1\u548c\u8bbe\u7f6e\u5b58\u5728\u51b2\u7a81\u3002\u60a8\u5728\u6b64\u5217\u8868\u4e2d\u4fdd\u6301\u52fe\u9009\u7684\u9879\u5c06\u4f1a\u66ff\u6362\u60a8\u5f53\u524d\u7684\u8bbe\u8ba1\u3002\u200b\u200b"],"Take me there":["\u7acb\u5373\u524d\u5f80"],"Note:":["\u5907\u6ce8\uff1a"],"Tip:":["\u63d0\u793a:"],"Let\u2019s do it":["\u5f00\u59cb\u884c\u52a8\u5427\uff01"],"Plugins to add:":["\u8981\u6dfb\u52a0\u7684\u63d2\u4ef6\uff1a"],"Is your Elementor Pro ready?":["\u60a8\u7684 Elementor Pro \u51c6\u5907\u597d\u4e86\u5417\uff1f"],"Missing Required Plugins:":["\u7f3a\u5c11\u6240\u9700\u7684\u63d2\u4ef6\uff1a"],"Plugins you already have:":["\u60a8\u5df2\u6709\u7684\u63d2\u4ef6\uff1a"],"Activating plugins:":["\u6fc0\u6d3b\u63d2\u4ef6\uff1a"],"All items are already selected by default. Uncheck the ones you don't want.":["\u9ed8\u8ba4\u60c5\u51b5\u4e0b\u5df2\u9009\u62e9\u6240\u6709\u9879\u76ee\u3002\u53d6\u6d88\u9009\u4e2d\u90a3\u4e9b\u60a8\u4e0d\u60f3\u8981\u7684\u3002"],"Select which parts you want to apply":["\u9009\u62e9\u60a8\u8981\u5e94\u7528\u7684\u90e8\u5206"],"If you don't include them, this kit may not work properly.":["\u5982\u679c\u4e0d\u5305\u542b\u5b83\u4eec\uff0c\u8be5\u5957\u4ef6\u53ef\u80fd\u65e0\u6cd5\u6b63\u5e38\u5de5\u4f5c\u3002"],"Required plugins are still missing.":["\u6240\u9700\u7684\u63d2\u4ef6\u4ecd\u7136\u7f3a\u5931\u3002"],"You can\u2019t use this Website Kit because it doesn\u2019t contain any content, pages, etc. Try again with a different file.":["\u60a8\u65e0\u6cd5\u4f7f\u7528\u6b64\u7f51\u7ad9\u5957\u4ef6\uff0c\u56e0\u4e3a\u5b83\u4e0d\u5305\u542b\u4efb\u4f55\u5185\u5bb9\u3001\u9875\u9762\u7b49\u3002\u8bf7\u4f7f\u7528\u5176\u4ed6\u6587\u4ef6\u91cd\u8bd5\u3002"],"The Website Kit you\u2019re using contains plugins for functionality, but no content or pages, etc.":["\u60a8\u4f7f\u7528\u7684\u7f51\u7ad9\u5957\u4ef6\u5305\u542b\u529f\u80fd\u63d2\u4ef6\uff0c\u4f46\u4e0d\u5305\u542b\u5185\u5bb9\u6216\u9875\u9762\u7b49\u3002"],"There are few plugins that we couldn't install:":["\u6709\u51e0\u4e2a\u63d2\u4ef6\u6211\u4eec\u65e0\u6cd5\u5b89\u88c5\uff1a"],"Make sure your Elementor Pro account is connected":["\u786e\u4fdd\u60a8\u7684 Elementor Pro \u5e10\u6237\u5df2\u8fde\u63a5"],"This file type is not allowed":["\u4e0d\u5141\u8bb8\u6b64\u6587\u4ef6\u7c7b\u578b"],"Without Elementor Pro, importing components like templates, widgets and popups won't work.":["\u5982\u679c\u6ca1\u6709 Elementor Pro\uff0c\u5219\u65e0\u6cd5\u5bfc\u5165\u6a21\u677f\u3001\u5c0f\u90e8\u4ef6\u548c\u5f39\u51fa\u7a97\u53e3\u7b49\u7ec4\u4ef6\u3002"],"Install Elementor Pro":["\u5b89\u88c5 Elementor Pro"],"These are the templates, content and site settings that come with your website templates.":["\u8fd9\u4e9b\u662f\u60a8\u7684\u7f51\u7ad9\u6a21\u677f\u968f\u9644\u7684\u6a21\u677f\uff0c\u5185\u5bb9\u548c\u7f51\u7ad9\u8bbe\u7f6e\u3002"],"You've imported and applied the following to your site:":["\u60a8\u5df2\u5c06\u4ee5\u4e0b\u5185\u5bb9\u5bfc\u5165\u5230\u60a8\u7684\u7f51\u7ad9\uff1a"],"See It Live":["\u5b9e\u65f6\u67e5\u770b"],"Show me how":["\u544a\u8bc9\u6211\u600e\u4e48\u505a"],"Try Again":["\u518d\u8bd5\u4e00\u6b21"],"Apply All":["\u5e94\u7528\u5168\u90e8"],"Remove from Favorites":["\u4ece\u6536\u85cf\u5939\u4e2d\u79fb\u9664"],"Add to Favorites":["\u52a0\u5165\u6536\u85cf"],"Customize":["\u81ea\u5b9a\u4e49"],"You can use everything in this kit, or Customize to only include some items.":["\u60a8\u53ef\u4ee5\u4f7f\u7528\u6b64\u5957\u4ef6\u4e2d\u7684\u6240\u6709\u5185\u